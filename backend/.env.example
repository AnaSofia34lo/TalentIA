# DEMO_RECRUITER_EMAIL="reclutador@prueba.com"
# DEMO_RECRUITER_PASSWORD="Reclutador123*"
# DEMO_RECRUITER_COMPANY="Empresa Prueba TalentIA"

# Gemini (extracción de CV — HU-06 / HU-07)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
