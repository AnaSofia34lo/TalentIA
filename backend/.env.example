# Base de datos PostgreSQL (Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"
SUPABASE_CV_BUCKET="hojas-de-vida"
SUPABASE_VIDEO_BUCKET="entrevistas-videos"

# App
PORT=3000
NODE_ENV="development"

# Cuenta demo reclutador (opcional; solo se crea si DEMO_RECRUITER_ENABLED=true)
